# ============================================================
# CAUSAL Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
# Allowed values: development | staging | production

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# Allowed values: DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://causal:causal_dev_password@localhost:5432/causal_db

# Sync URL is required for Alembic migrations
DATABASE_SYNC_URL=postgresql://causal:causal_dev_password@localhost:5432/causal_db

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend (Next.js) ───────────────────────────────────────
# Public API base URL — exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal API URL — used by Next.js server-side calls
API_URL=http://localhost:8000

# ── Security ─────────────────────────────────────────────────
# Secret key for signing tokens (will be used in future auth phase)
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# ── Feature Flags (Phase 1 — all off) ───────────────────────
ENABLE_CAUSAL_ENGINE=false
ENABLE_SIMULATION=false
ENABLE_INTERVENTIONS=false
